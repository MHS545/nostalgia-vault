# Flask Application Configuration
SECRET_KEY=dev-secret-key-change-in-production
FLASK_ENV=development

# AWS Secrets Manager Configuration (Used in production on EC2 with IAM Role)
USE_SECRETS_MANAGER=true
AWS_SECRET_NAME=memory-vault/database
AWS_REGION=us-east-1

# MySQL Database Configuration (Fallback when USE_SECRETS_MANAGER=false)
DB_USER=root
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=memory_vault

# Storage Configuration ('s3' or 'local')
STORAGE_TYPE=s3
AWS_S3_BUCKET=waniya-memory-vault-images
